{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "port": 10800,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "1.2.3.4",
            "port": 443,
            "users": [
              {
                "alterId": 0,
                "id": "109d47e4-4efe-45f8-9f63-52af26e1a5e2",
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "sni.example.com"
        },
        "wsSettings": {
          "path": "/ws",
          "headers": {
            "Host": "h.example"
          }
        }
      },
      "mux": {
        "enabled": true,
        "concurrency": 8
      }
    }
  ]
}